            text-align: center;
            font-size: 26px;
        }

        h2 {
            border-bottom: 1px solid #c8d7cf;
            padding-bottom: 4px;
            margin-top: 28px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin: 14px 0;
        }

        th, td {
            border: 1px solid #c8d7cf;
            padding: 8px;
            text-align: left;
        }

        th {
            background: #e8f4ed;
        }

        pre {
            background: #f6fbf8;
            border: 1px solid #c8d7cf;
            padding: 12px;
            white-space: pre-wrap;
            font-family: Consolas, monospace;
            font-size: 12px;
        }

        .capa {
            text-align: center;
            margin-bottom: 40px;
